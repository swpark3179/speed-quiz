# 서버 바인딩
HOST=0.0.0.0
PORT=3000
# 참여자가 접속할 주소 (QR 코드·입장 링크에 사용). 비워두면 서버의 LAN IP로 자동 생성
PUBLIC_BASE_URL=
# 포트만 다를 때(예: firewalld가 80 → 3000으로 리다이렉트) 링크·QR에 넣을 포트. IP는 자동 감지.
# 80이면 주소에서 포트가 생략됩니다. PUBLIC_BASE_URL을 지정했다면 무시됩니다.
PUBLIC_PORT=
# 데이터(DB·업로드·백업) 폴더. 상대 경로는 앱 루트 기준
DATA_DIR=./data
# HTTPS로 서비스할 때 true (쿠키 Secure, HSTS 활성화)
COOKIE_SECURE=false
# 리버스 프록시 뒤에서 실행할 때 true
TRUST_PROXY=false
SESSION_TTL_HOURS=12
# 관리자 계정이 하나도 없을 때 최초 관리자 생성 (생성 후 비밀번호를 꼭 변경하세요)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# 로그인 화면의 관리자 셀프 가입 허용 (아이디·닉네임 중복만 없으면 자동 승인). 막으려면 false
SIGNUP_ENABLED=true
ANSWER_GRACE_MS=300
MAX_UPLOAD_MB=5
LOG_LEVEL=info
